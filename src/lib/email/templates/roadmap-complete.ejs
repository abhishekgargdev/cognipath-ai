<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Your Skill Roadmap is Ready!</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F9F7F2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F9F7F2; table-layout: fixed; padding: 30px 10px;">
    <tr>
      <td align="center" style="padding: 0;">
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; background-color: #FFFFFF; border: 1px solid #DCD9D1; border-radius: 6px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.06);">
          
          <!-- Header Banner -->
          <tr>
            <td style="background-color: #121212; padding: 24px 30px; text-align: center; border-bottom: 3px solid #8B2635;">
              <h1 style="margin: 0; color: #F4F2EC; font-size: 22px; font-weight: 900; font-family: Georgia, serif; letter-spacing: -0.5px;">
                CogniPath <span style="color: #E08A95; font-style: italic;">AI</span>
              </h1>
              <p style="margin: 4px 0 0 0; color: #9E9A91; font-size: 11px; font-family: monospace; text-transform: uppercase; letter-spacing: 1.5px;">
                Adaptive Learning Engine
              </p>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding: 32px 30px; background-color: #FFFFFF;">
              <!-- Status Pill -->
              <table border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 16px;">
                <tr>
                  <td style="background-color: #1F3A2B; color: #FFFFFF; font-size: 10px; font-weight: bold; font-family: monospace; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 3px;">
                    ✅ Roadmap Generation Complete
                  </td>
                </tr>
              </table>

              <h2 style="margin: 0 0 12px 0; color: #121212; font-size: 20px; font-weight: 800; font-family: Georgia, serif; line-height: 1.3;">
                Your Custom Skill Roadmap is Ready
              </h2>

              <p style="margin: 0 0 20px 0; color: #5C5852; font-size: 14px; line-height: 1.6;">
                Hello <strong style="color: #121212;"><%= userName || 'Learner' %></strong>,<br />
                Great news! Your topological learning roadmap for <strong style="color: #8B2635;"><%= targetGoal %></strong> has been fully synthesized into sequential learning milestones.
              </p>

              <!-- Metrics Stats Table -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F4F1EA; border: 1px solid #DCD9D1; border-radius: 4px; margin-bottom: 24px;">
                <tr>
                  <td width="50%" align="center" style="padding: 16px; border-right: 1px solid #DCD9D1;">
                    <div style="color: #8B2635; font-size: 24px; font-weight: 900; font-family: Georgia, serif; margin-bottom: 2px;"><%= enrolledCount || 0 %></div>
                    <div style="color: #5C5852; font-size: 11px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.5px;">Enrolled Skills</div>
                  </td>
                  <td width="50%" align="center" style="padding: 16px;">
                    <div style="color: #8B2635; font-size: 24px; font-weight: 900; font-family: Georgia, serif; margin-bottom: 2px;"><%= nodeCount || 0 %></div>
                    <div style="color: #5C5852; font-size: 11px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.5px;">Roadmap Nodes</div>
                  </td>
                </tr>
              </table>

              <p style="margin: 0 0 24px 0; color: #5C5852; font-size: 13px; line-height: 1.6;">
                We are now proceeding with interactive lesson treatises and sandboxed code execution practice question pools for your active nodes.
              </p>

              <!-- Call to Action Button -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center">
                    <a href="<%= appUrl %>/roadmap" target="_blank" style="display: inline-block; background-color: #8B2635; color: #FFFFFF !important; text-decoration: none; font-size: 13px; font-weight: bold; font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding: 12px 28px; border-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.15);">
                      Explore Your Roadmap &rarr;
                    </a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #F4F1EA; padding: 18px 30px; border-top: 1px solid #DCD9D1; text-align: center;">
              <p style="margin: 0; color: #9E9A91; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, sans-serif; line-height: 1.5;">
                &copy; <%= currentYear %> CogniPath AI. Adaptive Curricular Intelligence.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
